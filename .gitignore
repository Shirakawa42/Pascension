# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/
Recordings/

# IDE / project files (regenerated by Unity)
*.csproj
# Headless tools use hand-authored projects; Unity regenerates only root projects.
!Tools/**/*.csproj
Tools/NyouAI/*launch*.json
Tools/NyouAI/*.log
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/

# OS
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Generated MCP state
Library/MCPForUnity/
[Bb]in/
Tools/**/obj/
Tools/**/bin/
Tools/**/__pycache__/
Tools/**/*.py[cod]
Tools/**/TestResults/
Tools/**/*.log
Tools/ZeroDepthTraining/results/
Tools/ZeroDepthTraining/runs/
Tools/TrainingWatchdog/results/

# Local training measurements and process state. Keep written investigations,
# reproducible probe sources, and compact provenance/fixture/summary metadata.
Tools/TrainingPreflight/results/**
!Tools/TrainingPreflight/results/**/
!Tools/TrainingPreflight/results/**/*.md
!Tools/TrainingPreflight/results/**/*.cs
!Tools/TrainingPreflight/results/**/*.csproj
!Tools/TrainingPreflight/results/**/*-source.txt
!Tools/TrainingPreflight/results/**/*manifest.json
!Tools/TrainingPreflight/results/**/*summary*.json
!Tools/TrainingPreflight/results/**/*fixture*.json
Tools/TrainingPreflight/results/**/bin/
Tools/TrainingPreflight/results/**/obj/
Tools/TrainingPreflight/results/windows-*-fixture-*/
Tools/TrainingPreflight/results/windows-supervisor-*/
Tools/TrainingPreflight/results/*windows*.json

# Host microbenchmarks are reproducible outputs; retain their provenance records.
Tools/TrainingPreflight/Host/cpu-*/**
!Tools/TrainingPreflight/Host/cpu-*/manifest.json
Tools/TrainingPreflight/Host/*selftest*.json
Tools/TrainingPreflight/Host/*benchmark*.json

# graphify knowledge graph (generated, machine-local — rebuild with /graphify Assets/Scripts)
graphify-out/
# The post-commit hook stub-rebuilds into Assets/Scripts/graphify-out (root-resolution
# quirk); the dir matches the pattern above but Unity's .meta for it does not.
Assets/Scripts/graphify-out.meta

# Local secrets
.env
.env.*

# Assets/Art/Shards/ holds ORIGINAL Anima-generated card art (committed).
# If official card images are ever imported over it (Pascension/Setup/Shards
# Art Import), those are PERSONAL USE ONLY — re-add the ignore, never commit them.

# Unity crash-recovery scratch scenes — never project content.
Assets/_Recovery/
Assets/_Recovery.meta
