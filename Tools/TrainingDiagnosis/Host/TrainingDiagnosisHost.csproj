    <Compile Include="../../../Assets/Scripts/Shards/Content/**/*.cs" LinkBase="Content" />
    <Compile Include="../../../Assets/Scripts/Shards/AI/**/*.cs" Exclude="../../../Assets/Scripts/Shards/AI/FrozenPolicy.cs" LinkBase="Incumbent" />
